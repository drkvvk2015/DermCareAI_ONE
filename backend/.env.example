APP_VERSION=4.0.0
APP_ENV=development
MODEL_DIR=models
ENABLE_EMBEDDED_DERM_MODEL=true
DERM_MODEL_ID=PREMAADC/vit-base-ham10000
MIN_CONFIDENCE=0.70
MAX_IMAGE_BYTES=12582912
CORS_ORIGINS=http://localhost:8081

# Clinic API security — keep enabled in every non-test environment
FIREBASE_AUTH_REQUIRED=true
FIREBASE_SERVICE_ACCOUNT_JSON=

# Razorpay: use UPI Intent/QR through hosted checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Indian SMS provider / DLT-approved template integration
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_SENDER_ID=

# Optional social-safe webhook (never include PHI)
SOCIAL_NOTIFICATION_WEBHOOK_URL=

# Durable audit store
AUDIT_DB_PATH=audit.db
