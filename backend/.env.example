APP_VERSION=5.1.0
APP_ENV=development
MODEL_DIR=models
ENABLE_EMBEDDED_DERM_MODEL=true
DERM_MODEL_ID=PREMAADC/vit-base-ham10000
MIN_CONFIDENCE=0.70
MAX_IMAGE_BYTES=12582912
# Vite defaults to 5173; 8081 remains supported for older local clients.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Clinic API security — keep enabled in every non-test environment
FIREBASE_AUTH_REQUIRED=true
FIREBASE_SERVICE_ACCOUNT_JSON=

# Razorpay: use UPI Intent/QR through hosted checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Indian SMS provider / DLT-approved template integration
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_SENDER_ID=

# Optional social-safe webhook (never include PHI)
SOCIAL_NOTIFICATION_WEBHOOK_URL=

# Durable audit store
AUDIT_DB_PATH=audit.db

# Cloudinary server-side signing (NEVER place CLOUDINARY_API_SECRET in the mobile app)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=dermcareai_signed
COMMERCE_DB_PATH=commerce.db
CLINICAL_DB_PATH=clinical.db
AI_GOVERNANCE_DB_PATH=ai_governance.db
# Firebase clinician claims required for clinical APIs: organization_id and clinic_id

# Production example: CORS_ORIGINS=https://app.example.com

# ---------------------------------------------------------------------------
# Wave 3 production persistence
# ---------------------------------------------------------------------------
# In production, use managed PostgreSQL. Store-specific URLs may override the
# shared DATABASE_URL when operational isolation is required.
DATABASE_URL=postgresql+psycopg://dermcareai:change-me@postgres:5432/dermcareai
COMMERCE_DATABASE_URL=
CLINICAL_DATABASE_URL=
AUDIT_DATABASE_URL=
AI_GOVERNANCE_DATABASE_URL=

# Staging object-store/database configuration is deployment-specific.
RETENTION_DEFAULT_DAYS=2555

# ---------------------------------------------------------------------------
# Tiered clinical AI activation
# ---------------------------------------------------------------------------
# Assistive capabilities may be enabled independently of diagnostic AI.
# Production diagnostic inference remains evidence-gated and fail-closed.
ENABLE_CLINICAL_ASSIST_AI=true
ENABLE_GENERATIVE_CLINICAL_ASSIST=false
AI_DIAGNOSTIC_MODE=disabled

# Generative assist: pin an immutable model revision before production use.
ENABLE_MEDGEMMA=false
MEDGEMMA_MODEL_ID=google/medgemma-1.5-4b-it
MEDGEMMA_REVISION=
MEDGEMMA_MAX_NEW_TOKENS=256
MEDGEMMA_TEMPERATURE=0.0
AI_VALIDATION_MANIFEST_PATH=
# Production default (container mount): /var/lib/dermcareai/ai/release-manifest.json
